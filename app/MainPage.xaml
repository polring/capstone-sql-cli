<Page x:Class="SqlApp.MainPage"
      x:Name="RootPage"
      UseLayoutRounding="True"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SqlApp"
      xmlns:models="using:SqlApp.Models"
      xmlns:controls="using:SqlApp.Controls"
      xmlns:services="using:SqlApp.Services"
      xmlns:converters="using:SqlApp.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="InverseVisibilityConverter" Invert="True" />
    <converters:StringToFilenameConverter x:Key="FilenameConverter" />
    <converters:SafeIntConverter x:Key="SafeIntConverter" />

  </Page.Resources>

  <Grid ColumnDefinitions="270,*" MinWidth="0">

    <!-- ==================== 1. LEFT SIDEBAR (FLUENT NAVIGATION PANE) ==================== -->
    <Border Grid.Column="0"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- App Brand Header -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Width="28" Height="28" CornerRadius="6">
              <FontIcon Glyph="&#xEA80;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="SQL AI Assistant" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="Windows 11 Fluent" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- New Chat Button -->
        <Button Grid.Row="1" Margin="14,4,14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Command="{x:Bind ViewModel.CreateNewSessionCommand}"
                Background="White"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                CornerRadius="6" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="새 대화" FontWeight="SemiBold" FontSize="13" />
          </StackPanel>
        </Button>

        <!-- Sessions List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Sessions}"
                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                  SelectionMode="Single" Padding="8,4">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:ConversationSession">
              <Grid Padding="6,6" CornerRadius="4">
                <!-- Normal Mode: Title Text & Action Buttons -->
                <Grid Visibility="{x:Bind IsEditingTitle, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}"
                      ColumnDefinitions="Auto,*,Auto,Auto">
                  <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="13" Margin="0,0,8,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                             FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <!-- Edit Title Button -->
                  <Button Grid.Column="2" Click="StartEditTitle_Click"
                          Background="Transparent" BorderThickness="0" Padding="5" Margin="2,0" CornerRadius="4"
                          ToolTipService.ToolTip="제목 변경">
                    <FontIcon Glyph="&#xE70F;" FontSize="11" />
                  </Button>
                  <!-- Delete Session Button -->
                  <Button Grid.Column="3" Click="DeleteSession_Click"
                          Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="4"
                          ToolTipService.ToolTip="대화 삭제">
                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                  </Button>
                </Grid>

                <!-- Edit Mode: Inline Pill Editor (blending with sidebar background) -->
                <Border Visibility="{x:Bind IsEditingTitle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12.5" Padding="4,2" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             IsSpellCheckEnabled="False"
                             UseSystemFocusVisuals="False"
                             KeyDown="EditTitleTextBox_KeyDown">
                      <TextBox.Resources>
                        <!-- Background transparency for all states -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

                        <!-- Border transparency for all states -->
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                        <!-- Zero border thickness for all states -->
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                      </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" Click="FinishEditTitle_Click"
                            Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="4"
                            ToolTipService.ToolTip="저장 (Enter)">
                      <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Sidebar Footer -->
        <Border Grid.Row="3" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
          <TextBlock Text="Local GGUF + SQLite Engine" FontSize="11"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

    <!-- ==================== 2. MAIN CHAT AREA ==================== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" MinWidth="0">

      <!-- Top Asset Context Bar -->
      <Border Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto">
          <ScrollViewer Grid.Column="0" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <RadioButton GroupName="ModelMode" Content="단일 모델" MinWidth="0"
                             IsChecked="{x:Bind ViewModel.IsSingleMode, Mode=OneWay}" Click="SingleMode_Click" />
                <RadioButton GroupName="ModelMode" Content="이중 모델" MinWidth="0"
                             IsChecked="{x:Bind ViewModel.IsDualMode, Mode=OneWay}" Click="DualMode_Click" />
              </StackPanel>
              <FontIcon Glyph="&#xF158;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
              <TextBlock Text="에셋 폴더" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              
              <ComboBox MinWidth="146" MaxWidth="245" ItemsSource="{x:Bind ViewModel.AvailableBundles}"
                        PlaceholderText="선택 가능한 폴더 없음"
                        AutomationProperties.Name="에셋 폴더"
                        SelectedItem="{x:Bind ViewModel.CurrentSessionBundle, Mode=OneWay}"
                        SelectionChanged="AssetBundleComboBox_SelectionChanged"
                        FontSize="12" CornerRadius="4">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:AssetBundle">
                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind DirectoryPath}">
                      <FontIcon Glyph="&#xEA86;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Button Content="폴더 탐색" Click="BrowseAssetFolder_Click" CornerRadius="4"
                      ToolTipService.ToolTip="현재 모드에 사용할 에셋 폴더 선택" />

              <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="7,0" MinHeight="28" VerticalAlignment="Center"
                      ToolTipService.ToolTip="{x:Bind ViewModel.SelectedModelPath, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="GGUF:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                  <TextBlock Text="{x:Bind ViewModel.SelectedModelFileName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                </StackPanel>
              </Border>

              <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="7,0" MinHeight="28" VerticalAlignment="Center"
                      ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDbPath, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="DB:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                  <TextBlock Text="{x:Bind ViewModel.SelectedDbFileName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                             MaxWidth="160" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Border>

              <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      CornerRadius="4" Padding="7,0,3,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Tokens:" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                  <TextBox x:Name="TokensTextBox"
                           Text="{x:Bind ViewModel.SelectedSession.MaxTokens, Mode=TwoWay, Converter={StaticResource SafeIntConverter}, ConverterParameter=200}"
                           LostFocus="TokensTextBox_LostFocus" AutomationProperties.Name="최대 생성 토큰 수"
                           ToolTipService.ToolTip="최대 생성 토큰 수" Width="46" MinWidth="0" MinHeight="26"
                           Padding="2,0" FontSize="12" VerticalContentAlignment="Center" TextAlignment="Center"
                           Background="Transparent" BorderThickness="0" CornerRadius="3" IsSpellCheckEnabled="False" />
                </StackPanel>
              </Border>

              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="병렬" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                <ComboBox ItemsSource="{x:Bind JsonBatchWorkerOptions}"
                          SelectedItem="{x:Bind ViewModel.JsonBatchWorkerCount, Mode=OneWay}"
                          SelectionChanged="JsonBatchWorkerCount_SelectionChanged"
                          AutomationProperties.Name="JSON 동시 처리 질문 수"
                          ToolTipService.ToolTip="JSON에서 동시에 처리할 질문 수입니다. 실행 중에 바꾸면 다음 JSON 파일부터 적용됩니다."
                          MinWidth="56" MinHeight="28" Padding="6,2" FontSize="12" CornerRadius="4" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Schema Viewer Button & Flyout -->
          <Button Grid.Column="1" Margin="8,0,0,0" FontSize="12" CornerRadius="4" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE8F1;" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="DB 스키마" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <StackPanel Width="290" MaxHeight="380">
                  <TextBlock Text="SQLite 테이블 및 컬럼 구조" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                  <ListView ItemsSource="{x:Bind ViewModel.CurrentSchema}">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="services:TableSchemaInfo">
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{x:Bind TableName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                          <ItemsControl ItemsSource="{x:Bind Columns}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Margin="8,1,0,1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <!-- ==================== 2. 단일 통합 대화 구역 (메인 영역 내 중앙 정렬) ==================== -->
      <Grid Grid.Row="1"
            HorizontalAlignment="Stretch"
            MaxWidth="800"
            MinWidth="0"
            Margin="24,0"
            RowDefinitions="*,Auto">

        <!-- 1. 위쪽: 말풍선 스크롤 영역 (통합 구역 가로폭 100% 공유) -->
        <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer"
                      Padding="0,16" MinWidth="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalContentAlignment="Stretch">
          <StackPanel HorizontalAlignment="Stretch">

              <!-- Welcome Empty State (Shown when session has no messages) -->
              <StackPanel Spacing="16" Margin="0,40,0,40" HorizontalAlignment="Stretch"
                          Visibility="{x:Bind ViewModel.SelectedSession.HasMessages, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Width="64" Height="64" CornerRadius="32"
                        HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xEA80;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <TextBlock Text="SQL AI Assistant" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="{x:Bind ViewModel.WelcomeDescription, Mode=OneWay}"
                             FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="750" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,12,0,0" MaxWidth="690">
                  <TextBlock Text="Recommended Prompt Examples" FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                  <ItemsControl ItemsSource="{x:Bind ViewModel.PromptSuggestions, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <Button Click="PromptSuggestion_Click" AutomationProperties.Name="{x:Bind}"
                                CornerRadius="6" Padding="12,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{x:Bind}" FontSize="12" TextWrapping="Wrap" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>

              <!-- Chat Message List -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSession.Messages, Mode=OneWay}"
                            HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,10" HorizontalAlignment="Stretch">

                      <!-- 1) User Message: Right-Aligned Speech Bubble -->
                      <Grid HorizontalAlignment="Right" MaxWidth="720" Margin="40,4,8,4"
                            Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="18,18,3,18" Padding="18,12"
                                BorderThickness="0">
                          <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                     IsTextSelectionEnabled="True"
                                     SelectionHighlightColor="#55FFFFFF"
                                     FontSize="15" TextWrapping="Wrap"
                                     Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                      </Grid>

                      <!-- 2) Assistant Message: Left-Aligned Speech Bubble -->
                      <Grid HorizontalAlignment="Left" MaxWidth="920" Margin="0,4,20,4"
                            Visibility="{x:Bind IsAssistant, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="18,18,18,4" Padding="20,16">
                          <StackPanel Spacing="12">

                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Model" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />

                                <!-- Thinking Progress Ring (답변 생성 대기 중) -->
                                <ProgressRing Width="14" Height="14" IsActive="True" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              Visibility="{x:Bind IsWaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Elapsed Time Badge (생성 완료 후) -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" VerticalAlignment="Center"
                                        Visibility="{x:Bind HasInferenceTime, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind InferenceTimeLabel, Mode=OneWay}"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>
                              </StackPanel>
                              <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                      Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                      AutomationProperties.Name="단계별 입력·출력 보기" ToolTipService.ToolTip="단계별 입력·출력 보기"
                                      Visibility="{x:Bind ShowStageDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <FontIcon Glyph="&#xE946;" FontSize="17" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button.Flyout>
                                  <Flyout>
                                    <ScrollViewer MaxWidth="500" MaxHeight="400" HorizontalScrollMode="Disabled"
                                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                      <TextBlock Text="{x:Bind StageDetails, Mode=OneWay}" FontSize="13"
                                                 TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                                    </ScrollViewer>
                                  </Flyout>
                                </Button.Flyout>
                              </Button>
                            </Grid>

                            <TextBlock Text="{x:Bind Text, Mode=OneWay}" IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                       Visibility="{x:Bind HasAssistantText, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Error Message if any -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10"
                                    Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           IsTextSelectionEnabled="True" VerticalAlignment="Center" FontSize="13.5" TextWrapping="Wrap" />
                                <Button Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0"
                                        Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0"
                                        AutomationProperties.Name="매퍼 오류 상세 보기" ToolTipService.ToolTip="매퍼 오류 상세 보기"
                                        Visibility="{x:Bind HasMapperError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                  <FontIcon Glyph="&#xE946;" FontSize="17" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                  <Button.Flyout>
                                    <Flyout>
                                      <ScrollViewer MaxWidth="400" MaxHeight="320" HorizontalScrollMode="Disabled"
                                                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind MapperErrorDetails, Mode=OneWay}" TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True" />
                                      </ScrollViewer>
                                    </Flyout>
                                  </Button.Flyout>
                                </Button>
                              </Grid>
                            </Border>

                            <TextBlock Text="{x:Bind GenerationWarning, Mode=OneWay}"
                                       Visibility="{x:Bind HasGenerationWarning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                       FontWeight="SemiBold" FontSize="13.5" TextWrapping="Wrap" />

                            <ItemsControl ItemsSource="{x:Bind SqlCandidates, Mode=OneWay}" HorizontalAlignment="Stretch"
                                          Visibility="{x:Bind HasSqlCandidates, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ChatSqlCandidate">
                                  <StackPanel HorizontalAlignment="Stretch" Spacing="4" Margin="0,3">
                                    <TextBlock Text="{x:Bind Label}" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                               Visibility="{x:Bind HasLabel, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                      <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                              CornerRadius="8" Padding="14,10"
                                              Visibility="{x:Bind HasSql, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{x:Bind Sql}" TextWrapping="Wrap" VerticalAlignment="Center"
                                                   FontFamily="Cascadia Code, Consolas, Courier New" FontSize="15"
                                                   Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                                      </Border>
                                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Grid ToolTipService.ToolTip="{x:Bind ValidationLabel, Mode=OneWay}"
                                              VerticalAlignment="Center"
                                              AutomationProperties.Name="{x:Bind ValidationLabel, Mode=OneWay}">
                                          <FontIcon Glyph="&#xE73E;" FontSize="15" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                                    Visibility="{x:Bind IsValidated, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                          <FontIcon Glyph="&#xE711;" FontSize="15" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                                    Visibility="{x:Bind HasValidationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                          <FontIcon Glyph="&#xE823;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Visibility="{x:Bind IsChecking, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                        <Button Click="RunSqlButton_Click" IsEnabled="{x:Bind CanExecuteSql, Mode=OneWay}"
                                                Visibility="{x:Bind HasSql, Converter={StaticResource BoolToVisibilityConverter}}"
                                                CornerRadius="4" Padding="10,4" FontSize="12.5" Content="▶"
                                                ToolTipService.ToolTip="이 SQL 실행" AutomationProperties.Name="이 SQL 실행" />
                                      </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ValidationError, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13"
                                               Visibility="{x:Bind HasValidationError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{x:Bind PipelineOutput, Mode=OneWay}" IsTextSelectionEnabled="True"
                                       FontFamily="Cascadia Code, Consolas, Courier New" TextWrapping="Wrap"
                                       Visibility="{x:Bind ShowPipelineOutput, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <!-- Running Query Indicator -->
                            <ProgressBar IsIndeterminate="True" Height="2"
                                         Visibility="{x:Bind IsRunningQuery, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                          </StackPanel>
                        </Border>
                      </Grid>

                      <!-- 3) Query Result Message: Content-Fitted Card -->
                      <Grid HorizontalAlignment="Left" MaxWidth="800" Margin="0,4,20,4"
                            Visibility="{x:Bind IsQueryResultSender, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="18,18,18,4" Padding="18,14">
                          <StackPanel>
                            <!-- Query Execution Header -->
                            <Grid ColumnDefinitions="*,Auto">
                              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{x:Bind QueryResultTitle}" TextWrapping="Wrap" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <TextBlock Text="{x:Bind QueryResult.RowCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="행" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="{x:Bind QueryResult.ExecutionTimeMs, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="ms" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                              </Grid>

                              <!-- 접기 / 펼치기 버튼 -->
                              <Button Grid.Column="1" Click="ToggleQueryResult_Click"
                                      Background="Transparent" BorderThickness="0" Padding="6,3" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <!-- 펼쳐져 있을 때: "접기" -->
                                  <StackPanel Orientation="Horizontal" Spacing="4"
                                              Visibility="{x:Bind IsQueryResultExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="접기" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70E;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <!-- 접혀 있을 때: "펼치기" -->
                                  <StackPanel Orientation="Horizontal" Spacing="4"
                                              Visibility="{x:Bind IsQueryResultExpanded, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}">
                                    <TextBlock Text="펼치기" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </StackPanel>
                              </Button>
                            </Grid>

                            <!-- 접히고 펼쳐지는 내용 구역 (에러 메시지 및 테이블) -->
                            <StackPanel Visibility="{x:Bind IsQueryResultExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,10,0,0">
                              <!-- Error in Query if any -->
                              <TextBlock Text="{x:Bind QueryResult.ErrorMessage, Mode=OneWay}"
                                         IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                         Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13" Margin="0,4"
                                         Visibility="{x:Bind QueryResult.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                              <!-- Table Records -->
                              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                            Visibility="{x:Bind QueryResult.HasRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="0,4">
                                  <!-- Column Headers -->
                                  <ItemsControl ItemsSource="{x:Bind QueryResult.Columns, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Border MinWidth="110" Padding="10,6"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,1,1">
                                          <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12.5"
                                                     IsTextSelectionEnabled="True"
                                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <!-- Rows -->
                                  <ItemsControl ItemsSource="{x:Bind QueryResult.Rows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Border MinWidth="110" Padding="10,6"
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                      BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding}" FontSize="12.5"
                                                           IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                              </Border>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </ScrollViewer>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </Grid>

                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Margin="0,4,0,16" Padding="8,8,8,6" CornerRadius="18"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
            <TextBox x:Name="PromptTextBox" Grid.Row="0"
                     PlaceholderText="{x:Bind ViewModel.PrimaryInputHint, Mode=OneWay}"
                     AutomationProperties.Name="채팅 입력" AcceptsReturn="True" TextWrapping="Wrap"
                     MinHeight="40" MaxHeight="160" Padding="5,4" FontSize="14"
                     Background="Transparent" BorderThickness="0" IsSpellCheckEnabled="False"
                     PreviewKeyDown="PromptTextBox_PreviewKeyDown">
              <TextBox.Resources>
                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
              </TextBox.Resources>
            </TextBox>

            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="4">
              <Button Grid.Column="0" Click="AttachButton_Click" Background="Transparent" BorderThickness="0"
                      IsEnabled="{x:Bind ViewModel.CanStartInference, Mode=OneWay}"
                      Width="34" Height="34" Padding="0" CornerRadius="17"
                      AutomationProperties.Name="JSON 파일로 추론 또는 평가" ToolTipService.ToolTip="JSON 파일로 추론 또는 평가">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
              </Button>
              <TextBlock Grid.Column="1" Margin="4,0" VerticalAlignment="Center" FontSize="12"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                         Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                         ToolTipService.ToolTip="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
              <controls:StageRangeSlider Grid.Column="2" x:Name="PipelineRange" VerticalAlignment="Center"
                                         Visibility="{x:Bind ViewModel.IsDualMode, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button Grid.Column="3" Click="SendButton_Click" Width="34" Height="34" Padding="0" CornerRadius="17"
                      Visibility="{x:Bind ViewModel.IsJsonBatchRunning, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}"
                      IsEnabled="{x:Bind ViewModel.CanStartInference, Mode=OneWay}"
                      Background="Transparent" BorderThickness="0" AutomationProperties.Name="전송" ToolTipService.ToolTip="전송 (Enter)">
                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource ComposerGradientBrush}">
                  <Grid>
                    <Path Width="9" Height="11" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M0,0 L9,5.5 L0,11 Z" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                          Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}" />
                    <ProgressRing Width="15" Height="15" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                  IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                  Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                  </Grid>
                </Border>
              </Button>
              <Button Grid.Column="3" Command="{x:Bind ViewModel.CancelJsonBatchCommand}"
                      Visibility="{x:Bind ViewModel.IsJsonBatchRunning, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                      Width="34" Height="34" Padding="0" CornerRadius="17" Background="Transparent" BorderThickness="0"
                      AutomationProperties.Name="진행 중인 질문을 모두 마친 뒤 JSON 처리 중단" ToolTipService.ToolTip="진행 중인 질문을 모두 마친 뒤 중단">
                <Border Width="28" Height="28" CornerRadius="14" Background="{ThemeResource ComposerGradientBrush}">
                  <Rectangle Width="10" Height="10" RadiusX="1" RadiusY="1"
                             Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
              </Button>
            </Grid>
          </Grid>
        </Border>

      </Grid>

    </Grid>

  </Grid>
</Page>
