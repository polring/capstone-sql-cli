<Page x:Class="SqlApp.MainPage"
      x:Name="RootPage"
      UseLayoutRounding="True"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:SqlApp"
      xmlns:models="using:SqlApp.Models"
      xmlns:services="using:SqlApp.Services"
      xmlns:converters="using:SqlApp.Converters"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

  <Page.Resources>
    <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <converters:BoolToVisibilityConverter x:Key="InverseVisibilityConverter" Invert="True" />
    <converters:StringToFilenameConverter x:Key="FilenameConverter" />
    <converters:ElapsedMsConverter x:Key="ElapsedMsConverter" />
    <converters:SafeIntConverter x:Key="SafeIntConverter" />

  </Page.Resources>

  <Grid ColumnDefinitions="270,*" MinWidth="0">

    <!-- ==================== 1. LEFT SIDEBAR (FLUENT NAVIGATION PANE) ==================== -->
    <Border Grid.Column="0"
            Background="{ThemeResource LayerOnMicaBaseAltFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- App Brand Header -->
        <Grid Grid.Row="0" Margin="16,14,16,10">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Border Background="{ThemeResource AccentFillColorDefaultBrush}" Width="28" Height="28" CornerRadius="6">
              <FontIcon Glyph="&#xEA80;" FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="SQL AI Assistant" FontWeight="SemiBold" FontSize="14" />
              <TextBlock Text="Windows 11 Fluent" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- New Chat Button -->
        <Button Grid.Row="1" Margin="14,4,14,10" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                Command="{x:Bind ViewModel.CreateNewSessionCommand}"
                Background="White"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                CornerRadius="6" Padding="12,8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <FontIcon Glyph="&#xE710;" FontSize="13" Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock Text="새 대화" FontWeight="SemiBold" FontSize="13" />
          </StackPanel>
        </Button>

        <!-- Sessions List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Sessions}"
                  SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}"
                  SelectionMode="Single" Padding="8,4">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="models:ConversationSession">
              <Grid Padding="6,6" CornerRadius="4">
                <!-- Normal Mode: Title Text & Action Buttons -->
                <Grid Visibility="{x:Bind IsEditingTitle, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}"
                      ColumnDefinitions="Auto,*,Auto,Auto">
                  <FontIcon Grid.Column="0" Glyph="&#xE8BD;" FontSize="13" Margin="0,0,8,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{x:Bind Title, Mode=OneWay}"
                             FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                  <!-- Edit Title Button -->
                  <Button Grid.Column="2" Click="StartEditTitle_Click"
                          Background="Transparent" BorderThickness="0" Padding="5" Margin="2,0" CornerRadius="4"
                          ToolTipService.ToolTip="제목 변경">
                    <FontIcon Glyph="&#xE70F;" FontSize="11" />
                  </Button>
                  <!-- Delete Session Button -->
                  <Button Grid.Column="3" Click="DeleteSession_Click"
                          Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="4"
                          ToolTipService.ToolTip="대화 삭제">
                    <FontIcon Glyph="&#xE74D;" FontSize="11" />
                  </Button>
                </Grid>

                <!-- Edit Mode: Inline Pill Editor (blending with sidebar background) -->
                <Border Visibility="{x:Bind IsEditingTitle, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="4,2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBox Grid.Column="0"
                             Text="{x:Bind Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12.5" Padding="4,2" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0"
                             IsSpellCheckEnabled="False"
                             UseSystemFocusVisuals="False"
                             KeyDown="EditTitleTextBox_KeyDown">
                      <TextBox.Resources>
                        <!-- Background transparency for all states -->
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

                        <!-- Border transparency for all states -->
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                        <!-- Zero border thickness for all states -->
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                      </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" Click="FinishEditTitle_Click"
                            Background="Transparent" BorderThickness="0" Padding="5" CornerRadius="4"
                            ToolTipService.ToolTip="저장 (Enter)">
                      <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>

        <!-- Sidebar Footer -->
        <Border Grid.Row="3" Padding="14,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
          <TextBlock Text="Local GGUF + SQLite Engine" FontSize="11"
                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
        </Border>
      </Grid>
    </Border>

    <!-- ==================== 2. MAIN CHAT AREA ==================== -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*" MinWidth="0">

      <!-- Top Asset Context Bar -->
      <Border Grid.Row="0"
              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
              BorderThickness="0,0,0,1" Padding="16,10">
        <Grid ColumnDefinitions="*,Auto">
          <!-- Asset Bundle Selector & Badges (Scrollable horizontally to prevent forcing Column 1 width) -->
          <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <FontIcon Glyph="&#xF158;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
              <TextBlock Text="에셋 폴더" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
              
              <ComboBox MinWidth="180" ItemsSource="{x:Bind ViewModel.AvailableBundles}"
                        PlaceholderText="선택 가능한 폴더 없음"
                        AutomationProperties.Name="에셋 폴더"
                        SelectedItem="{x:Bind ViewModel.CurrentSessionBundle, Mode=OneWay}"
                        SelectionChanged="AssetBundleComboBox_SelectionChanged"
                        FontSize="12" CornerRadius="4">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:AssetBundle">
                    <StackPanel Orientation="Horizontal" Spacing="8" ToolTipService.ToolTip="{x:Bind DirectoryPath}">
                      <FontIcon Glyph="&#xEA86;" FontSize="11" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{x:Bind Name}" FontWeight="Medium" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Button Content="폴더 탐색" Click="BrowseAssetFolder_Click" CornerRadius="4"
                      ToolTipService.ToolTip="GGUF 모델과 SQLite DB가 함께 있는 폴더 선택" />

              <!-- Files in the selected asset folder -->
              <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,0,0,0" VerticalAlignment="Center">
                <!-- GGUF File Badge -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="7,3" VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedModelPath, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="GGUF:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedModelFileName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>

                <!-- DB File Badge -->
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="4" Padding="7,3" VerticalAlignment="Center"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SelectedDbPath, Mode=OneWay}">
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="DB:" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.SelectedDbFileName, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               MaxWidth="160" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Border>

              </StackPanel>
            </StackPanel>
          </ScrollViewer>

          <!-- Schema Viewer Button & Flyout -->
          <Button Grid.Column="1" Margin="8,0,0,0" FontSize="12" CornerRadius="4" Padding="10,6">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <FontIcon Glyph="&#xE8F1;" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="DB 스키마" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="Bottom">
                <StackPanel Width="290" MaxHeight="380">
                  <TextBlock Text="SQLite 테이블 및 컬럼 구조" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                  <ListView ItemsSource="{x:Bind ViewModel.CurrentSchema}">
                    <ListView.ItemTemplate>
                      <DataTemplate x:DataType="services:TableSchemaInfo">
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{x:Bind TableName}" FontWeight="SemiBold" FontSize="12" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                          <ItemsControl ItemsSource="{x:Bind Columns}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate>
                                <TextBlock Text="{Binding}" FontSize="11" Margin="8,1,0,1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </DataTemplate>
                    </ListView.ItemTemplate>
                  </ListView>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>
        </Grid>
      </Border>

      <!-- ==================== 2. 단일 통합 대화 구역 (메인 영역 내 중앙 정렬) ==================== -->
      <Grid Grid.Row="1"
            HorizontalAlignment="Stretch"
            MaxWidth="800"
            MinWidth="0"
            Margin="24,0"
            RowDefinitions="*,Auto">

        <!-- 1. 위쪽: 말풍선 스크롤 영역 (통합 구역 가로폭 100% 공유) -->
        <ScrollViewer Grid.Row="0" x:Name="ChatScrollViewer"
                      Padding="0,16" MinWidth="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalContentAlignment="Stretch">
          <StackPanel HorizontalAlignment="Stretch">

              <!-- Welcome Empty State (Shown when session has no messages) -->
              <StackPanel Spacing="16" Margin="0,40,0,40" HorizontalAlignment="Center"
                          Visibility="{x:Bind ViewModel.SelectedSession.HasMessages, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}">
                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" Width="64" Height="64" CornerRadius="32"
                        HorizontalAlignment="Center">
                  <FontIcon Glyph="&#xEA80;" FontSize="32" Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                  <TextBlock Text="SQL AI Assistant" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
                  <TextBlock Text="영어로 질문하면 모델이 SQL을 생성합니다. 실행을 누르면 같은 에셋 폴더의 DB에서 결과를 조회합니다."
                             FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                             HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="750" />
                </StackPanel>

                <!-- Quick Suggestions (English) -->
                <StackPanel Spacing="8" Margin="0,12,0,0" HorizontalAlignment="Center" Width="690">
                  <TextBlock Text="Recommended Prompt Examples" FontSize="11" FontWeight="SemiBold"
                             Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalAlignment="Center" />
                  <Button Command="{x:Bind ViewModel.UsePromptSuggestionCommand}"
                          CommandParameter="please show me information of peter."
                          CornerRadius="6" Padding="12,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="please show me information of peter." FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Command="{x:Bind ViewModel.UsePromptSuggestionCommand}"
                          CommandParameter="show me where peter lives in."
                          CornerRadius="6" Padding="12,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="show me where peter lives in." FontSize="12" />
                    </StackPanel>
                  </Button>
                  <Button Command="{x:Bind ViewModel.UsePromptSuggestionCommand}"
                          CommandParameter="List all products with stock quantity 10 or less."
                          CornerRadius="6" Padding="12,7" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <FontIcon Glyph="&#xE8BD;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                      <TextBlock Text="List all products with stock quantity 10 or less." FontSize="12" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>

              <!-- Chat Message List -->
              <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedSession.Messages, Mode=OneWay}"
                            HorizontalAlignment="Stretch">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,10" HorizontalAlignment="Stretch">

                      <!-- 1) User Message: Right-Aligned Speech Bubble -->
                      <Grid HorizontalAlignment="Right" MaxWidth="720" Margin="40,4,8,4"
                            Visibility="{x:Bind IsUser, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="18,18,3,18" Padding="18,12"
                                BorderThickness="0">
                          <TextBlock Text="{x:Bind Text, Mode=OneWay}"
                                     IsTextSelectionEnabled="True"
                                     SelectionHighlightColor="#55FFFFFF"
                                     FontSize="15" TextWrapping="Wrap"
                                     Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                      </Grid>

                      <!-- 2) Assistant Message: Left-Aligned Speech Bubble -->
                      <Grid HorizontalAlignment="Left" MaxWidth="920" Margin="0,4,20,4"
                            Visibility="{x:Bind IsAssistant, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="18,18,18,4" Padding="20,16">
                          <StackPanel Spacing="12">

                            <!-- Header: Model Label + Badges + Action Buttons -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <!-- Left Info Badges (Icon removed, 'Model' label) -->
                              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="Model" FontWeight="SemiBold" FontSize="14.5" VerticalAlignment="Center" />

                                <!-- Thinking Progress Ring (답변 생성 대기 중) -->
                                <ProgressRing Width="14" Height="14" IsActive="True" VerticalAlignment="Center"
                                              Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                              Visibility="{x:Bind IsWaitingResponse, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!-- Elapsed Time Badge (생성 완료 후) -->
                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="7,3" VerticalAlignment="Center"
                                        Visibility="{x:Bind HasSql, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                  <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE823;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{x:Bind InferenceTimeMs, Mode=OneWay, Converter={StaticResource ElapsedMsConverter}}"
                                               FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Border>


                              </StackPanel>

                              <!-- Right Action Buttons: Play (Run) + Copy -->
                              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                          Visibility="{x:Bind HasSql, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <!-- Play (Run) Button -->
                                <Button Click="RunSqlButton_Click"
                                        CornerRadius="4" Padding="10,4" FontSize="12.5"
                                        ToolTipService.ToolTip="SQLite DB에 즉시 실행">
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE768;" FontSize="11.5" VerticalAlignment="Center" />
                                    <TextBlock Text="실행" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>

                                <!-- Copy Button -->
                                <Button Click="CopySqlButton_Click"
                                        CornerRadius="4" Padding="10,4" FontSize="12.5"
                                        ToolTipService.ToolTip="SQL 클립보드 복사">
                                  <StackPanel Orientation="Horizontal" Spacing="5">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="11.5" VerticalAlignment="Center" />
                                    <TextBlock Text="복사" FontSize="12.5" VerticalAlignment="Center" />
                                  </StackPanel>
                                </Button>
                              </StackPanel>
                            </Grid>

                            <!-- Error Message if any -->
                            <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="12,10"
                                    Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                              <TextBlock Text="{x:Bind ErrorMessage, Mode=OneWay}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                         IsTextSelectionEnabled="True"
                                         FontSize="13.5" TextWrapping="Wrap" />
                            </Border>

                            <!-- SQL Code Block -->
                            <Border Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,14"
                                    Visibility="{x:Bind HasSql, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                              <TextBlock Text="{x:Bind Sql, Mode=OneWay}"
                                         IsTextSelectionEnabled="True"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="15" Foreground="{ThemeResource AccentFillColorDefaultBrush}" TextWrapping="Wrap" />
                            </Border>

                            <!-- Running Query Indicator -->
                            <ProgressBar IsIndeterminate="True" Height="2"
                                         Visibility="{x:Bind IsRunningQuery, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                          </StackPanel>
                        </Border>
                      </Grid>

                      <!-- 3) Query Result Message: Content-Fitted Card -->
                      <Grid HorizontalAlignment="Left" MaxWidth="800" Margin="0,4,20,4"
                            Visibility="{x:Bind IsQueryResultSender, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="18,18,18,4" Padding="18,14">
                          <StackPanel>
                            <!-- Query Execution Header -->
                            <Grid ColumnDefinitions="*,Auto">
                              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE8F1;" FontSize="13" Foreground="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="DB 쿼리 실행 결과" FontWeight="Bold" FontSize="13.5"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <TextBlock Text="{x:Bind QueryResult.RowCount, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="행" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="•" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="{x:Bind QueryResult.ExecutionTimeMs, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                  <TextBlock Text="ms" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                              </StackPanel>

                              <!-- 접기 / 펼치기 버튼 -->
                              <Button Grid.Column="1" Click="ToggleQueryResult_Click"
                                      Background="Transparent" BorderThickness="0" Padding="6,3" CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                  <!-- 펼쳐져 있을 때: "접기" -->
                                  <StackPanel Orientation="Horizontal" Spacing="4"
                                              Visibility="{x:Bind IsQueryResultExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="접기" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70E;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                  <!-- 접혀 있을 때: "펼치기" -->
                                  <StackPanel Orientation="Horizontal" Spacing="4"
                                              Visibility="{x:Bind IsQueryResultExpanded, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}">
                                    <TextBlock Text="펼치기" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <FontIcon Glyph="&#xE70D;" FontSize="9.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </StackPanel>
                              </Button>
                            </Grid>

                            <!-- 접히고 펼쳐지는 내용 구역 (에러 메시지 및 테이블) -->
                            <StackPanel Visibility="{x:Bind IsQueryResultExpanded, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Margin="0,10,0,0">
                              <!-- Error in Query if any -->
                              <TextBlock Text="{x:Bind QueryResult.ErrorMessage, Mode=OneWay}"
                                         IsTextSelectionEnabled="True" TextWrapping="Wrap"
                                         Foreground="{ThemeResource SystemFillColorCriticalBrush}" FontSize="13" Margin="0,4"
                                         Visibility="{x:Bind QueryResult.HasError, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                              <!-- Table Records -->
                              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                            Visibility="{x:Bind QueryResult.HasRows, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Margin="0,4">
                                  <!-- Column Headers -->
                                  <ItemsControl ItemsSource="{x:Bind QueryResult.Columns, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                      <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                      </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <Border MinWidth="110" Padding="10,6"
                                                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="0,0,1,1">
                                          <TextBlock Text="{Binding}" FontWeight="SemiBold" FontSize="12.5"
                                                     IsTextSelectionEnabled="True"
                                                     Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>

                                  <!-- Rows -->
                                  <ItemsControl ItemsSource="{x:Bind QueryResult.Rows, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate>
                                        <ItemsControl ItemsSource="{Binding}">
                                          <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                              <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                          </ItemsControl.ItemsPanel>
                                          <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                              <Border MinWidth="110" Padding="10,6"
                                                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                      BorderThickness="0,0,1,1">
                                                <TextBlock Text="{Binding}" FontSize="12.5"
                                                           IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                              </Border>
                                            </DataTemplate>
                                          </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </ScrollViewer>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                      </Grid>

                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- 2. 아래쪽: 플로팅 통합 입력 바 (통합 구역 가로폭 100% 공유) -->
        <Grid Grid.Row="1" Background="Transparent" Padding="0,4,0,16" MinWidth="0" HorizontalAlignment="Stretch">
          <StackPanel HorizontalAlignment="Stretch" Spacing="6">

            <!-- 둥근 모서리 사각형 통합 입력 카드 (CornerRadius="18") -->
              <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1"
                      CornerRadius="18"
                      Padding="16,12,16,12">
                <Grid RowDefinitions="Auto,Auto">

                  <!-- 1) Text Input -->
                  <TextBox Grid.Row="0" x:Name="PromptTextBox"
                           PlaceholderText="질문을 입력하세요.."
                           AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" MaxHeight="160"
                           BorderThickness="0" Background="Transparent" Padding="6,6,6,8" FontSize="15"
                           IsSpellCheckEnabled="False"
                           UseSystemFocusVisuals="False"
                           PreviewKeyDown="PromptTextBox_PreviewKeyDown">
                    <TextBox.Resources>
                      <!-- Background transparency for all states -->
                      <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

                      <!-- Border transparency for all states -->
                      <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                      <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                      <!-- Zero border thickness for all states -->
                      <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                      <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                  </TextBox>

                  <!-- 2) Bottom Control Bar -->
                  <Grid Grid.Row="1" Margin="0,8,0,0" ColumnDefinitions="Auto,*,Auto">
                    
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                      <!-- [+] Attach Button -->
                      <Button Click="AttachButton_Click" CornerRadius="6" Width="32" Height="32" Padding="0"
                              VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                              ToolTipService.ToolTip="JSON 파일 가져오기">
                        <FontIcon Glyph="&#xE723;" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Button>

                    </StackPanel>

                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" VerticalAlignment="Center">
                      <!-- Tokens: White Badge (Height="32", vertically centered number) -->
                      <Border Background="White"
                              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                              BorderThickness="1" CornerRadius="6" Padding="8,0"
                              Height="32" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                          <TextBlock Text="Tokens:" FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                          <TextBox x:Name="TokensTextBox"
                                   Text="{x:Bind ViewModel.SelectedSession.MaxTokens, Mode=TwoWay, Converter={StaticResource SafeIntConverter}, ConverterParameter=64}"
                                   LostFocus="TokensTextBox_LostFocus"
                                   Width="36" Height="26" MinHeight="0" FontSize="12"
                                   Padding="0,2,0,0"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   VerticalContentAlignment="Center"
                                   Background="Transparent" BorderThickness="0"
                                   IsSpellCheckEnabled="False"
                                   UseSystemFocusVisuals="False">
                            <TextBox.Resources>
                              <!-- Background transparency for all states -->
                              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />

                              <!-- Border transparency for all states -->
                              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                              <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />

                              <!-- Zero border thickness for all states -->
                              <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                          </TextBox>
                        </StackPanel>
                      </Border>

                      <!-- Send Button (Height="32", Width="32") -->
                      <Button Style="{StaticResource AccentButtonStyle}"
                              Click="SendButton_Click"
                              CornerRadius="16" Width="32" Height="32" Padding="0"
                              VerticalAlignment="Center" ToolTipService.ToolTip="전송 (Enter)">
                        <Grid>
                          <FontIcon Glyph="&#xE724;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource InverseVisibilityConverter}}" />
                          <ProgressRing Width="16" Height="16"
                                        Foreground="White"
                                        IsActive="{x:Bind ViewModel.IsGenerating, Mode=OneWay}"
                                        Visibility="{x:Bind ViewModel.IsGenerating, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </Grid>
                      </Button>
                    </StackPanel>

                  </Grid>

                </Grid>
              </Border>

            </StackPanel>
        </Grid>

      </Grid>

    </Grid>

  </Grid>
</Page>
